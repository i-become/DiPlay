<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lets DiPlay register a self-managed call with Telecom; a normal permission, no prompt. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <queries>
        <package android:name="com.byd.carsettings" />
        <package android:name="com.byd.appmgr" />
        <package android:name="com.byd.deviceinfo" />
        <package android:name="com.byd.service" />
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <package android:name="com.byd.clusterdebug" />
        <package android:name="com.ts.car.someip.service" />
        <package android:name="com.byd.amapservice" />
        <package android:name="com.byd.automap" />
        <!-- Hongqi OEM packages and stock Gaode (package visibility on API 30+). -->
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.autonavi.amapauto.custom" />
        <package android:name="com.faw.navi" />
        <package android:name="com.faw.map" />
        <package android:name="com.faw.hq" />
        <package android:name="com.faw.hongqi" />
        <package android:name="com.hongqi.car" />
        <package android:name="com.hongqi.launcher" />
        <package android:name="com.fawcar.launcher" />
        <package android:name="com.fawcar.systemui" />
        <package android:name="com.neusoft.hongqi" />
        <package android:name="com.neusoft.ssp.ces.hongqi" />
        <package android:name="com.neusoft.navigation" />
        <package android:name="com.cchq.car" />
        <package android:name="com.juyou.app" />
        <package android:name="com.neusoft.factorymode" />
        <package android:name="com.neusoft.hongqi.navigation" />
        <package android:name="com.neusoft.ivi.navigation" />
        <package android:name="com.neusoft.amapauto" />
        <package android:name="com.neusoft.ssp.ces.hongqi.amap" />
        <package android:name="com.autonavi.amapauto.hongqi" />
        <package android:name="com.faw.autonavi" />
        <package android:name="com.hongqi.navigation" />
        <package android:name="ltd.qisi.navi" />
        <package android:name="ltd.qisi.adapterservice" />
        <package android:name="faw.system.viewservice" />
        <package android:name="com.neusoft.carlink" />
        <intent>
            <action android:name="AUTONAVI_STANDARD_BROADCAST_SEND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MAPS" />
        </intent>
        <intent>
            <action android:name="com.android.settings.WIFI_TETHER_SETTINGS" />
        </intent>
    </queries>

    <application android:usesCleartextTraffic="true">
        <service
            android:name="com.shilapi.xcertplay.network.CarPlayVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false" />

        <!-- Only Telecom can bind it; it carries no UI or audio, see PhoneAudioRoute. -->
        <service
            android:name="com.shilapi.xcertplay.telecom.PhoneAudioConnectionService"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
