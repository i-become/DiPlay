<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Read-only vehicle state on Hongqi HS5 Qisi firmware. -->
    <uses-permission android:name="ltd.qisi.adapterservice.permission.READ_SETTINGS" />
    <!-- Optional, user-authorized startup of the car's own hotspot. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: diagnostic reports in the visible Downloads/DiPlay folder on Android 9.
         Android 10+ needs no permission for this, so it is never requested there. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Optional: the dashboard map as a card over the home screen. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional, owner-enabled Usage Access for dashboard activity and theme detection. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- The centre card also follows whichever launcher is the default home. -->
    <queries>
        <package android:name="com.alfus.controller" />
        <package android:name="ltd.qisi.sotasupportapp" />
        <package android:name="ltd.qisi.adapterservice" />
        <package android:name="ltd.qisi.systemservice" />
        <package android:name="faw.system.viewservice" />
        <package android:name="com.autonavi.amapauto" />
        <package android:name="com.autonavi.amapauto.custom" />
        <package android:name="com.faw.navi" />
        <package android:name="com.faw.hongqi" />
        <package android:name="com.juyou.app" />
        <intent>
            <action android:name="android.intent.action.VOICE_COMMAND" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VOICE_ASSIST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.ASSIST" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
    <application>
        <receiver
            android:name="com.shilapi.xcertplay.update.UpdatePackageReplacedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <provider
            android:name="com.shilapi.xcertplay.DiPlayBootInitProvider"
            android:authorities="${applicationId}.boot-init"
            android:exported="false"
            android:initOrder="199" />
        <provider
            android:name="com.shilapi.xcertplay.DiagnosticReportProvider"
            android:authorities="${applicationId}.diagnostic-reports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_report_paths" />
        </provider>
        <provider
            android:name="com.shilapi.xcertplay.update.UpdateApkProvider"
            android:authorities="${applicationId}.update-apks"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_apk_paths" />
        </provider>
        <activity
            android:name="com.shilapi.xcertplay.newui.NewUiActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Xcertplay">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.shilapi.xcertplay.DiPlayActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Xcertplay" />
        <service android:name="com.shilapi.xcertplay.DiPlaySessionService"
            android:exported="false" android:foregroundServiceType="connectedDevice|microphone|location" />

        <activity
            android:name="com.shilapi.xcertplay.CarPlayHostActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- NWD delivers signed byte values on its OEM steering-wheel broadcast bus. -->
        <receiver
            android:name="com.shilapi.xcertplay.NwdSteeringKeyReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter android:priority="2147483647">
                <action android:name="com.nwd.action.ACTION_KEY_VALUE" />
            </intent-filter>
        </receiver>

        <!-- Hongqi 仪表飞屏 window on the cluster display; it takes focus so the wheel back key closes it. -->
        <activity
            android:name="com.shilapi.xcertplay.Hs5ClusterActivity"
            android:taskAffinity="${applicationId}.hs5cluster"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:exported="false"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.Hs5Cluster" />

        <activity
            android:name="com.shilapi.xcertplay.CarPlayVideoActivity"
            android:configChanges="density|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="false"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.MainActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Xcertplay" />

        <activity
            android:name="com.shilapi.xcertplay.ImageCropActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:screenOrientation="fullSensor"
            android:theme="@style/Theme.Xcertplay" />

        <!-- CarPlay navigation widget, for launchers that host standard widgets. -->
        <receiver
            android:name="com.shilapi.xcertplay.NavigationWidget"
            android:exported="false"
            android:label="@string/navigation_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/navigation_widget_info" />
        </receiver>

        <!-- The live dashboard map for launchers that embed it (docs/LAUNCHER_INTEGRATION.md). -->
        <service
            android:name="com.shilapi.xcertplay.MapEmbedService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.shihab.diplay.action.EMBED_MAP" />
            </intent-filter>
        </service>

        <!-- Optional: learn the vehicle's steering-wheel keys for dashboard map control. -->
        <service
            android:name="com.shilapi.xcertplay.WheelKeyService"
            android:exported="true"
            android:label="@string/wheel_key_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/wheel_key_service" />
        </service>

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.shilapi.xcertplay.UsbAutoConfirmService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/usb_auto_confirm_service_config" />
        </service>
    </application>

</manifest>
