<?xml version="1.0" encoding="utf-8"?>
<!-- Visual reference: glass card fill (#AARRGGBB). Compose uses NewUiSurfaces.panelBrush(). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/new_ui_card_normal"
        android:startColor="@color/new_ui_card_secondary"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/new_ui_dropdown_border" />
    <corners android:radius="16dp" />
</shape>
