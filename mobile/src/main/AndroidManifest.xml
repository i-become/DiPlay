<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sideloaded car builds: discover vendor Gaode / Neusoft packages for HUD output. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/ic_launcher_rounded"
        android:label="@string/launcher_label"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@drawable/ic_launcher_rounded"
        android:supportsRtl="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.Xcertplay">

        <meta-data
            android:name="android.allow_multiple_resumed_activities"
            android:value="true" />

        <meta-data android:name="Group" android:value="GROUP CARPLAY" />
        <meta-data android:name="Domain" android:value="DOMAIN CARPLAY" />
        <meta-data
            android:name="Ability"
            android:value="com.shilapi.xcertplay.newui.NewUiActivity" />
        <meta-data android:name="MoreApp" android:value="true" />

        <receiver
            android:name="com.shilapi.xcertplay.BootReceiver"
            android:enabled="true"
            tools:replace="android:enabled" />

        <receiver
            android:name="com.shilapi.xcertplay.PhoneBluetoothReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
