# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# Carlink's ICCOA SDK is supplied as a verified dex by injectCarlinkDex*. The
# compileOnly stubs are intentionally not packaged, so R8 must retain the
# referenced API surface and accept that the implementation arrives later.
-keep class com.ucar.vehiclesdk.** { *; }
-keep class com.share.connect.** { *; }
-dontwarn com.ucar.vehiclesdk.**
-dontwarn com.share.connect.**

# The injected dex is invisible to R8. Preserve its callbacks and the host-side
# AndroidX runtime it references, as required by the validated donor release rules.
-keep class com.shilapi.xcertplay.carlink.** { *; }
-keep class androidx.annotation.** { *; }
-keep class androidx.collection.** { *; }
-keep class androidx.core.app.** { *; }
-keep class androidx.room.** { *; }
-keep class androidx.sqlite.db.** { *; }
-keep class com.google.common.util.concurrent.ListenableFuture { *; }

# Carlink handshake messages are in the post-R8 SDK dex. Keep their runtime,
# including fields accessed reflectively by GeneratedMessageLite schemas.
-keep class com.google.protobuf.** { *; }
